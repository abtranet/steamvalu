# Contact form delivery. The destination address is read on the server only and
# is never sent to the browser — see src/app/api/contact/route.ts.
CONTACT_TO_EMAIL=sales@globalsabt.com

# Verified sender for the mail provider. Resend's shared sender works for
# testing; use an address on a domain you have verified before going live.
CONTACT_FROM_EMAIL="STEAM VALUE <onboarding@resend.dev>"

# https://resend.com/api-keys — without this the form reports that email is
# unavailable and points people at WhatsApp instead of silently dropping mail.
RESEND_API_KEY=
